generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  USER
}

enum PlanCode {
  FREE
  PRO
  AGENCY
}

enum BillingProvider {
  STRIPE
  PAYPAL
  BANK_TRANSFER
}

enum PaymentRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELED
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  UNPAID
  EXPIRED
}

enum UsageAction {
  GENERATE
  REGENERATE
  MAKE_SHORTER
  MAKE_FRIENDLIER
  MAKE_MORE_PROFESSIONAL
  ADD_EMPATHY
}

enum UsageStatus {
  RESERVED
  COMPLETED
  RELEASED
}

enum WebhookStatus {
  RECEIVED
  PROCESSED
  FAILED
}

model User {
  id              String             @id
  name            String
  email           String             @unique
  emailVerified   Boolean            @default(false)
  image           String?
  role            UserRole           @default(USER)
  isActive        Boolean            @default(true)
  defaultLength   String             @default("MEDIUM")
  defaultLanguage String             @default("AUTO")
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  sessions        Session[]
  accounts        Account[]
  businesses      Business[]
  generations     ReviewGeneration[]
  usageRecords    UsageRecord[]
  subscription    Subscription?
  usageEvents     UsageEvent[]
  adminAuditLogs  AdminAuditLog[]    @relation("AdminAuditActor")
  paymentRequests BankTransferRequest[]
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id
  issuer                String
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([issuer, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model Business {
  id              String             @id @default(cuid())
  userId          String
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  industry        String
  description     String             @default("")
  preferredTone   String             @default("WARM_PROFESSIONAL")
  defaultLanguage String             @default("AUTO")
  signOff         String             @default("")
  phrasesToUse    String             @default("")
  phrasesToAvoid  String             @default("")
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  generations     ReviewGeneration[]

  @@index([userId])
}

model ReviewGeneration {
  id                String      @id @default(cuid())
  userId            String
  businessId        String
  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  business          Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  reviewText        String
  rating            Int
  tone              String
  responseLength    String
  language          String
  generatedResponse String
  finalResponse     String?
  model             String
  tokensUsed        Int?
  inputTokens       Int?
  outputTokens      Int?
  provider          String?
  action            UsageAction @default(GENERATE)
  usageEvent        UsageEvent?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([userId, createdAt])
  @@index([businessId, createdAt])
  @@index([rating])
}

model UsageRecord {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  period          String
  generationsUsed Int      @default(0)
  updatedAt       DateTime @updatedAt

  @@unique([userId, period])
}

model UsageEvent {
  id              String            @id @default(cuid())
  userId          String
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  requestKey      String            @unique
  period          String
  action          UsageAction
  status          UsageStatus       @default(RESERVED)
  provider        String?
  model           String?
  inputTokens     Int?
  outputTokens    Int?
  totalTokens     Int?
  failureCategory String?
  expiresAt       DateTime
  generationId    String?           @unique
  generation      ReviewGeneration? @relation(fields: [generationId], references: [id], onDelete: SetNull)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([userId, period, status])
  @@index([status, expiresAt])
}

model Plan {
  id                String          @id @default(cuid())
  code              PlanCode        @unique
  name              String
  generationLimit   Int
  businessLimit     Int
  monthlyPriceCents Int             @default(0)
  isActive          Boolean         @default(true)
  sortOrder         Int             @default(0)
  subscriptions     Subscription[]
  providerPrices    ProviderPrice[]
  paymentRequests   BankTransferRequest[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

model ProviderPrice {
  id                String          @id @default(cuid())
  planId            String
  plan              Plan            @relation(fields: [planId], references: [id], onDelete: Cascade)
  provider          BillingProvider
  externalProductId String?
  externalPriceId   String?
  isActive          Boolean         @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([planId, provider])
}

model Subscription {
  id                     String             @id @default(cuid())
  userId                 String             @unique
  user                   User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId                 String
  plan                   Plan               @relation(fields: [planId], references: [id])
  status                 SubscriptionStatus @default(UNPAID)
  provider               BillingProvider?
  externalCustomerId     String?
  externalSubscriptionId String?
  gracePeriodEnd         DateTime?
  cancelAtPeriodEnd      Boolean            @default(false)
  providerUpdatedAt      DateTime?
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  @@unique([provider, externalSubscriptionId])
}

model BankTransferRequest {
  id                String               @id @default(cuid())
  userId            String
  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId            String
  plan              Plan                 @relation(fields: [planId], references: [id])
  status            PaymentRequestStatus @default(PENDING)
  transferReference String?
  customerNote      String?
  adminNote         String?
  reviewedById      String?
  reviewedAt        DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@index([status, createdAt])
  @@index([userId, createdAt])
}

model RateLimitBucket {
  key       String   @id
  count     Int      @default(0)
  expiresAt DateTime
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
}

model SystemSetting {
  key       String   @id
  group     String
  value     String
  encrypted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([group])
}

model InstallationState {
  id          String    @id @default("primary")
  installed   Boolean   @default(false)
  installedAt DateTime?
  version     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model WebhookEvent {
  id               String          @id @default(cuid())
  provider         BillingProvider
  externalEventId  String
  status           WebhookStatus   @default(RECEIVED)
  payloadHash      String
  payloadEncrypted String?
  eventType        String
  occurredAt       DateTime?
  errorMessage     String?
  processedAt      DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@unique([provider, externalEventId])
  @@index([status, createdAt])
}

model AdminAuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation("AdminAuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  targetType String
  targetId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([targetType, targetId])
  @@index([createdAt])
}
